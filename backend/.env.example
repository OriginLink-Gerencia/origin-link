# Copiar a backend/.env para desarrollo local (backend/.env NO se sube al repo).
ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://originlink:originlink@localhost:5432/originlink
CORS_ORIGINS=http://localhost:5173
# URL del frontend: se usa para armar los enlaces de invitación (HU-06). En Cloud Run, la de Firebase Hosting.
FRONTEND_URL=http://localhost:5173
MODEL_PATH=models/tcn.pt

# Genere una clave aleatoria (ej. Python: secrets.token_urlsafe(48)). No suba el .env.
JWT_SECRET_KEY=REEMPLAZAR_CON_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_CARACTERES
